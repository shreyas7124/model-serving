# Multi-node physical GPU deploy via passwordless SSH
# Control node runs the app / `python -m shared.deploy`
# Workers: Docker + NVIDIA toolkit; SSH key auth from control.

AUTO_DEPLOY_MODEL=true
AUTO_DEPLOY_TEARDOWN_ON_EXIT=true

# Comma-separated: local and/or user@host
DEPLOY_NODES=local,ubuntu@gpu1.example.com,ubuntu@gpu2.example.com
DEPLOY_SSH_USER=ubuntu
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_SSH_OPTS=-o BatchMode=yes -o StrictHostKeyChecking=accept-new
# DEPLOY_NODE_URL_HOSTS=gpu1.example.com:10.0.0.11,gpu2.example.com:10.0.0.12
# DEPLOY_LOCAL_ADVERTISE_HOST=10.0.0.10
DEPLOY_REMOTE_DIR=/tmp/model-serving-runtime

MODEL_DEPLOY_MODE=hybrid
VLLM_REPLICA_COUNT=3
TENSOR_PARALLEL_SIZE=2
GPU_PER_REPLICA=2
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HUGGING_FACE_HUB_TOKEN=

# NIM example:
# DEPLOY_NODES=local,gpu1
# NIM_REPLICA_COUNT=2
# NGC_API_KEY=
# NIM_IMAGE=nvcr.io/nim/meta/llama-3.1-8b-instruct:latest

# Inspect without deploying:
# python -m shared.deploy inventory --nodes local,gpu1,gpu2
# python -m shared.deploy plan --engine vllm
