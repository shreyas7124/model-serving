# Copy relevant vars into each app's .env for multi-node deployments

MULTI_NODE=true
CLUSTER_NAME=model-serving
CLUSTER_PEERS=http://node1:8080,http://node2:8080
NODE_ID=node-1
NODE_ROLE=all
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=https://models.example.com
WORKERS=2
THREADS=8

# Shared state — mount the same path on every node (NFS/EFS) or use Redis
SHARED_DATA_DIR=/data/model-serving
# AUTH_DB_PATH=/data/model-serving/users.db
# CHAT_DB_PATH=/data/model-serving/chat_history.db

REDIS_URL=redis://redis:6379/0
USE_REDIS=true

# --- LLM placement ---
# hybrid   = default — sharded multi-GPU/node model + optional multi-replica
# sharded  = one logical model split across GPUs/nodes (does not fit one GPU)
# replica  = multiple full model instances only (when each copy fits one node)
MODEL_DEPLOY_MODE=hybrid


# Multi-replica: each URL is a COMPLETE model
BACKEND_URLS=http://nim-a:8000/v1/chat/completions,http://nim-b:8000/v1/chat/completions
BACKEND_STRATEGY=round_robin

# Single-model sharding (model too large for one GPU/node)
# TENSOR_PARALLEL_SIZE=4
# PIPELINE_PARALLEL_SIZE=1
# SHARD_RANK=0
# SHARD_WORLD_SIZE=4
# SHARD_GROUP=kimi-k3-prod
# CUDA_VISIBLE_DEVICES=0,1,2,3
# HF_DEVICE_MAP=auto
# HF_MAX_MEMORY_PER_GPU=20GiB
# HF_MAX_MEMORY_CPU=64GiB
# MODEL_SHARD_BACKENDS=http://gpu0:8000/v1/chat/completions,http://gpu1:8000/v1/chat/completions
# MODEL_COORDINATOR_URL=http://vllm-router:8000/v1/chat/completions
# LOAD_MODEL_WEIGHTS=true

SECRET_KEY=replace-with-long-random-string
STICKY_SESSIONS=true

# --- NeMo Switchyard (IDE assistants) ---
# SWITCHYARD_ENABLED=true
# SWITCHYARD_STRATEGY=escalation
# SWITCHYARD_ROUTE_ID=switchyard/agent
# SWITCHYARD_CONFIG=/app/nim-ide-assistant/switchyard-models.example.json
# SWITCHYARD_WEAK_MODEL=meta/llama-3.1-8b-instruct
# SWITCHYARD_WEAK_URL=http://nim-weak:8000/v1/chat/completions
# SWITCHYARD_STRONG_MODEL=meta/llama-3.1-70b-instruct
# SWITCHYARD_STRONG_URL=http://nim-strong:8000/v1/chat/completions
# SWITCHYARD_JUDGE_URL=http://nim-weak:8000/v1/chat/completions



# --- HF apps (vLLM-only) ---
# LOAD_MODEL_WEIGHTS=false
# VLLM_API_URL=http://vllm-0:8000/v1/chat/completions
# BACKEND_URLS=http://vllm-0:8000/v1/chat/completions,http://vllm-1:8000/v1/chat/completions
# HF_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
# See deploy/env.vllm.example and deploy/scripts/generate_vllm_compose.py

# Auto-deploy model containers from the app process
# AUTO_DEPLOY_MODEL=true
# AUTO_DEPLOY_TEARDOWN_ON_EXIT=true
# NGC_API_KEY=  # NIM
# HUGGING_FACE_HUB_TOKEN=  # vLLM pulls
