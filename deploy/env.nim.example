# NIM auto-deploy / placement
AUTO_DEPLOY_MODEL=true
AUTO_DEPLOY_TEARDOWN_ON_EXIT=true
AUTO_DEPLOY_SHARED=false
AUTO_DEPLOY_WAIT_SECONDS=300

MODEL_DEPLOY_MODE=replica
NIM_REPLICA_COUNT=1
TENSOR_PARALLEL_SIZE=1
GPU_DEVICES=0
NIM_PORT=8000
NIM_IMAGE=nvcr.io/nim/meta/llama-3.1-8b-instruct:latest
NIM_MODEL_NAME=meta/llama-3.1-8b-instruct
NGC_API_KEY=  # required for auto-deploy

# Optional: skip deploy if already running
# BACKEND_URLS=http://127.0.0.1:8000/v1/chat/completions
# NIM_API_URL=http://127.0.0.1:8000/v1/chat/completions
