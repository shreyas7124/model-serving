AUTO_DEPLOY_MODEL=true
AUTO_DEPLOY_TEARDOWN_ON_EXIT=true
AUTO_DEPLOY_SHARED=false
# AUTO_DEPLOY_PROJECT=
AUTO_DEPLOY_WAIT_SECONDS=300

# vLLM multi-instance placement for HF apps
# Generate compose: python deploy/scripts/generate_vllm_compose.py --include-apps

MODEL_DEPLOY_MODE=hybrid          # hybrid | replica | sharded
VLLM_REPLICA_COUNT=2              # full model copies (forced to 1 if sharded)
TENSOR_PARALLEL_SIZE=2            # GPUs per replica (vLLM --tensor-parallel-size)
PIPELINE_PARALLEL_SIZE=1
GPU_PER_REPLICA=2                 # optional override; default tp*pp
GPU_DEVICES=0,1,2,3               # host GPU ids to slice across replicas

VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_MAX_MODEL_LEN=8192
VLLM_PORT=8000
VLLM_ENABLE_PREFIX_CACHING=true

# Hierarchical KV: GPU working set always on; Mooncake engages on overflow/miss/share
# Leave unset to auto-enable Mooncake profile hint when VLLM_REPLICA_COUNT>1
# VLLM_MOONCAKE_KV=true
# MOONCAKE_MASTER=mooncake-master:50051

LOAD_MODEL_WEIGHTS=false
BACKEND_STRATEGY=round_robin
# BACKEND_URLS is written by the generator, e.g.:
# BACKEND_URLS=http://vllm-0:8000/v1/chat/completions,http://vllm-1:8000/v1/chat/completions

# Optional single-URL alias
# VLLM_API_URL=http://localhost:8000/v1/chat/completions

HUGGING_FACE_HUB_TOKEN=
API_KEY=hf-coding-assistant-key
